<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title><%= guild.name %> — DealerBot</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
*{margin:0;padding:0;box-sizing:border-box;}
body{font-family:'Inter',sans-serif;background:#0f0f17;color:#e2e8f0;}
nav{background:#1e1e2e;border-bottom:1px solid #2d2d3d;padding:16px 32px;display:flex;align-items:center;justify-content:space-between;}
.brand{font-size:1.1rem;font-weight:700;color:#a855f7;}
.user{display:flex;align-items:center;gap:10px;font-size:.9rem;}
.user img{width:32px;height:32px;border-radius:50%;}
a.back{color:#94a3b8;text-decoration:none;font-size:.9rem;}
.layout{display:flex;min-height:calc(100vh - 57px);}
.sidebar{width:220px;background:#1a1a28;border-right:1px solid #2d2d3d;padding:20px 0;flex-shrink:0;}
.sidebar a{display:flex;align-items:center;gap:10px;padding:10px 20px;color:#94a3b8;text-decoration:none;font-size:.9rem;transition:all .15s;}
.sidebar a:hover,.sidebar a.active{background:#2d1f4e;color:#e2e8f0;border-right:3px solid #a855f7;}
.sidebar .cat{padding:10px 20px 6px;font-size:.7rem;font-weight:600;color:#475569;text-transform:uppercase;letter-spacing:.08em;}
.main{flex:1;padding:36px 40px;max-width:760px;}
h2{font-size:1.4rem;font-weight:700;margin-bottom:6px;}
.desc{color:#64748b;font-size:.9rem;margin-bottom:28px;}
.card{background:#1e1e2e;border:1px solid #2d2d3d;border-radius:14px;padding:24px;margin-bottom:20px;}
.card h3{font-weight:600;margin-bottom:18px;display:flex;align-items:center;gap:8px;}
.form-row{display:flex;flex-direction:column;gap:6px;margin-bottom:16px;}
.form-row label{font-size:.85rem;color:#94a3b8;font-weight:500;}
input[type=text],input[type=color],select{background:#0f0f17;border:1px solid #2d2d3d;border-radius:8px;padding:9px 12px;color:#e2e8f0;font-size:.9rem;width:100%;outline:none;transition:border-color .2s;}
input:focus,select:focus{border-color:#7c3aed;}
input[type=color]{padding:4px;width:48px;height:36px;cursor:pointer;}
.toggle-row{display:flex;align-items:center;justify-content:space-between;margin-bottom:14px;}
.toggle-row label{font-size:.9rem;}
.toggle{position:relative;width:44px;height:24px;}
.toggle input{opacity:0;width:0;height:0;}
.slider{position:absolute;inset:0;background:#2d2d3d;border-radius:24px;cursor:pointer;transition:.3s;}
.slider:before{content:'';position:absolute;height:18px;width:18px;left:3px;bottom:3px;background:#94a3b8;border-radius:50%;transition:.3s;}
input:checked+.slider{background:#7c3aed;}
input:checked+.slider:before{transform:translateX(20px);background:#fff;}
.btn-save{background:linear-gradient(135deg,#7c3aed,#a855f7);color:#fff;border:none;padding:10px 24px;border-radius:8px;font-size:.9rem;font-weight:600;cursor:pointer;transition:opacity .2s;}
.btn-save:hover{opacity:.85;}
.badge{display:inline-block;padding:3px 10px;border-radius:20px;font-size:.75rem;font-weight:600;}
.badge.active{background:#1a3a2a;color:#4ade80;}
.badge.inactive{background:#3a1a1a;color:#f87171;}
.plus-box{background:linear-gradient(135deg,#2d1f4e,#1a1a2e);border:1px solid #7c3aed;border-radius:14px;padding:24px;margin-bottom:20px;}
.plus-box h3{color:#a855f7;}
.plus-info{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:16px;}
.plus-info div{background:#1e1e2e;border-radius:8px;padding:12px;}
.plus-info .lbl{font-size:.75rem;color:#64748b;margin-bottom:4px;}
.plus-info .val{font-size:.95rem;font-weight:600;}
footer{padding:30px 40px;color:#475569;font-size:.8rem;}
.toast{position:fixed;bottom:24px;right:24px;background:#22c55e;color:#fff;padding:12px 24px;border-radius:10px;font-weight:600;display:none;z-index:99;}
</style>
</head>
<body>
<nav>
  <div style="display:flex;align-items:center;gap:16px;">
    <a href="/dashboard" class="back">← Back</a>
    <span class="brand">💎 DealerBot</span>
  </div>
  <div class="user">
    <img src="https://cdn.discordapp.com/avatars/<%= user.id %>/<%= user.avatar %>.png" alt="">
    <%= user.username %>
  </div>
</nav>
<div class="layout">
  <div class="sidebar">
    <div class="cat">Settings</div>
    <a href="#general" class="active">⚙️ General</a>
    <a href="#protection">🛡️ Protection</a>
    <a href="#logs">📋 Logs</a>
    <a href="#ticket">🎟️ Tickets</a>
    <a href="#levels">✨ Levels</a>
    <div class="cat">Info</div>
    <a href="#plus">💎 Plus</a>
  </div>
  <div class="main">
    <h2><%= guild.name %></h2>
    <p class="desc">Configure DealerBot settings for this server.</p>

    <%# ── Plus ─────────────────────────────────────────── %>
    <% if (pl) { %>
    <div class="plus-box" id="plus">
      <h3>💎 Plus Active <span class="badge active">Active</span></h3>
      <div class="plus-info">
        <div><div class="lbl">Sub Number</div><div class="val">#<%= pl.sub_number %></div></div>
        <div><div class="lbl">Plan</div><div class="val"><%= pl.plan %></div></div>
        <div><div class="lbl">Registered For</div><div class="val"><%= pl.user_id %></div></div>
        <div><div class="lbl">Expires</div><div class="val"><%= pl.is_lifetime||pl.is_partnered ? 'Lifetime/Partnered' : new Date(pl.expires_at*1000).toLocaleDateString() %></div></div>
      </div>
    </div>
    <% } else { %>
    <div class="plus-box" id="plus">
      <h3>💎 Plus <span class="badge inactive">Inactive</span></h3>
      <p style="color:#94a3b8;margin-top:8px;font-size:.9rem;">Contact the bot owner to activate Plus for this server.</p>
    </div>
    <% } %>

    <%# ── General ──────────────────────────────────────── %>
    <div class="card" id="general">
      <h3>⚙️ General Settings</h3>
      <form id="general-form">
        <div class="form-row">
          <label>Command Prefix</label>
          <input type="text" name="prefix" value="<%= g.prefix||'#' %>" maxlength="5">
        </div>
        <div class="form-row">
          <label>Embed Color</label>
          <input type="color" name="embed_color" value="#<%= g.embed_color||'7C3AED' %>">
        </div>
        <button type="submit" class="btn-save">Save Changes</button>
      </form>
    </div>

    <%# ── Protection ───────────────────────────────────── %>
    <div class="card" id="protection">
      <h3>🛡️ Protection / AutoMod</h3>
      <form id="protection-form">
        <div class="toggle-row">
          <label>Anti-Spam</label>
          <label class="toggle"><input type="checkbox" name="antispam" <%=prot?.antispam?'checked':''%>><span class="slider"></span></label>
        </div>
        <div class="toggle-row">
          <label>Anti-Links</label>
          <label class="toggle"><input type="checkbox" name="antilinks" <%=prot?.antilinks?'checked':''%>><span class="slider"></span></label>
        </div>
        <div class="toggle-row">
          <label>Anti-Bots</label>
          <label class="toggle"><input type="checkbox" name="antibots" <%=prot?.antibots?'checked':''%>><span class="slider"></span></label>
        </div>
        <div class="toggle-row">
          <label>Anti-Nuke</label>
          <label class="toggle"><input type="checkbox" name="antinuke" <%=prot?.antinuke?'checked':''%>><span class="slider"></span></label>
        </div>
        <div class="form-row">
          <label>Spam Limit (messages)</label>
          <input type="text" name="antispam_limit" value="<%= prot?.antispam_limit||5 %>">
        </div>
        <div class="form-row">
          <label>Spam Time Window (seconds)</label>
          <input type="text" name="antispam_time" value="<%= prot?.antispam_time||5 %>">
        </div>
        <div class="form-row">
          <label>Default Punishment</label>
          <select name="punishment">
            <option <%=prot?.punishment==='mute'?'selected':''%>>mute</option>
            <option <%=prot?.punishment==='kick'?'selected':''%>>kick</option>
            <option <%=prot?.punishment==='ban' ?'selected':''%>>ban</option>
          </select>
        </div>
        <button type="submit" class="btn-save">Save Changes</button>
      </form>
    </div>

    <%# ── Logs ─────────────────────────────────────────── %>
    <div class="card" id="logs">
      <h3>📋 Log Settings</h3>
      <form id="logs-form">
        <div class="toggle-row">
          <label>Message Logs</label>
          <label class="toggle"><input type="checkbox" name="messages_enabled" <%=logs?.messages_enabled?'checked':''%>><span class="slider"></span></label>
        </div>
        <div class="form-row">
          <label>Message Logs Channel ID</label>
          <input type="text" name="messages_channel" value="<%= logs?.messages_channel||'' %>" placeholder="Channel ID">
        </div>
        <div class="toggle-row">
          <label>Moderation Logs</label>
          <label class="toggle"><input type="checkbox" name="moderation_enabled" <%=logs?.moderation_enabled?'checked':''%>><span class="slider"></span></label>
        </div>
        <div class="form-row">
          <label>Moderation Logs Channel ID</label>
          <input type="text" name="moderation_channel" value="<%= logs?.moderation_channel||'' %>" placeholder="Channel ID">
        </div>
        <div class="toggle-row">
          <label>Join / Leave Logs</label>
          <label class="toggle"><input type="checkbox" name="joins_enabled" <%=logs?.joins_enabled?'checked':''%>><span class="slider"></span></label>
        </div>
        <div class="form-row">
          <label>Join/Leave Channel ID</label>
          <input type="text" name="joins_channel" value="<%= logs?.joins_channel||'' %>" placeholder="Channel ID">
        </div>
        <button type="submit" class="btn-save">Save Changes</button>
      </form>
    </div>

  </div>
</div>
<div class="toast" id="toast">✅ Saved!</div>
<script>
const guildId = '<%= guild.id %>';
function toast(){ const t=document.getElementById('toast'); t.style.display='block'; setTimeout(()=>t.style.display='none',2500); }
function saveForm(formId, endpoint) {
  document.getElementById(formId).addEventListener('submit', async e=>{
    e.preventDefault();
    const data = Object.fromEntries(new FormData(e.target));
    // checkboxes not in FormData when unchecked — set 0
    e.target.querySelectorAll('input[type=checkbox]').forEach(cb=>{ if(!data[cb.name]) data[cb.name]=0; });
    await fetch(`/api/${guildId}/${endpoint}`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(data)});
    toast();
  });
}
saveForm('general-form','general');
saveForm('protection-form','protection');
saveForm('logs-form','logs');
document.querySelectorAll('.sidebar a').forEach(a=>{
  a.addEventListener('click',e=>{ document.querySelectorAll('.sidebar a').forEach(x=>x.classList.remove('active')); a.classList.add('active'); });
});
</script>
</body>
</html>
